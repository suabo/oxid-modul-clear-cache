{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate} %}
<style>
    h1, h3 { padding-bottom: 0; margin-bottom: 0; }
    table { width: 100%; }
    .list span {
        display: inline-block;
        margin-top: 20px;
        padding: 4px 10px;
        border: solid #7A7A7A;
        border-radius: 4px 4px 0 0;
        border-width: 1px 1px 0 1px;
        background: #fff;
        margin-bottom: -1px;
        font-size: 14px;
        font-family: Verdana, Arial, serif;
    }
    table.info td:first-child { text-align: right; }
    table.info td:last-child { font-weight: bold; text-align: left; }
    .btn {
        padding: 4px 20px;
        border: 1px solid darkgreen;
        border-radius: 4px;
        cursor: pointer;
        color: darkgreen;
        background: #fff;
    }
    .btn:hover { box-shadow: 3px 3px 3px #ccc; }
    .btn.btn-danger { color: red; border-color: red; }
    .alert.alert-success {
        padding: 10px;
        border: 1px solid green;
        border-radius: 4px;
        background: darkgreen;
        color: #fff;
    }
    .text-muted { color: #999; }
    pre {
        width: 90%;
        min-height: 100px;
        max-height: 300px;
        overflow-y: scroll;
        white-space: pre-line;
        background: #eee;
        padding: 4px;
    }
    .settings { max-width: 280px; }
    .info .dynamic.cleared { color: darkgreen; }
</style>

<h1>{{ translate({ ident: "SUABOCLEARCACHE_TITLE" }) }}</h1>

<form id="clearcache" name="clearcache" method="post" action="{{ oViewConf.getSelfLink()|raw }}">
    <div>
        <input type="hidden" name="cl" value="suaboclearcache">
        <input type="hidden" name="fnc" value="">
    </div>
    <table>
        <colgroup>
            <col style="width: 50%;" />
            <col style="width: 50%;" />
        </colgroup>
        <tr>
            <td style="vertical-align: top;">
                <h2>{{ translate({ ident: "SUABOCLEARCACHE_SETTINGS" }) }}:</h2>
                <table class="settings">
                    <colgroup>
                        <col style="width: 30px;" />
                        <col />
                    </colgroup>
                    <tr>
                        <td>
                            <input id="clearcacheall" type="radio" name="clearcache[mode]" value="0"
                                   onclick="clearCacheTotal();" {{ aSettings.mode == "0" ? 'checked' : '' }}>
                        </td>
                        <td>
                            <label for="clearcacheall">{{ translate({ ident: "SUABOCLEARCACHE_SETTINGS_CLEAR_ALL" }) }}</label>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="height:20px;">
                            <hr />
                            <div style="margin:-18px auto 0 auto;width:35px;text-align: center;background: #fff;">
                                {{ translate({ ident: "SUABOCLEARCACHE_OR" }) }}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: top;">
                            <input id="clearcacheparted" type="radio" name="clearcache[mode]" value="1"
                                   onclick="clearCacheParted(null, null);" {{ aSettings.mode == "1" ? 'checked' : '' }}>
                        </td>
                        <td>
                            <label for="clearcacheparted">{{ translate({ ident: "SUABOCLEARCACHE_SETTINGS_PART_CLEAR" }) }}</label>
                            <div style="padding:15px;">
                                <table>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="clearShopCache" name="clearcache[shop]" value="1" onclick="clearCacheParted('shop', this);" {{ aSettings.shop ? 'checked' : '' }}>
                                        </td>
                                        <td><label for="clearShopCache">{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEAR_SHOP" }) }}</label></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="clearPersParamCache" name="clearcache[persshop]" value="1" onclick="clearCacheParted('persshop', this);" {{ aSettings.persshop ? 'checked' : '' }}>
                                        </td>
                                        <td><label for="clearPersParamCache">{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEAR_PERSSHOP" }) }}</label></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="clearTplCache" name="clearcache[tpl]" value="1" onclick="clearCacheParted('tpl', this);" {{ aSettings.tpl ? 'checked' : '' }}>
                                        </td>
                                        <td><label for="clearTplCache">{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEAR_TPL" }) }}</label></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="clearLangCache" name="clearcache[lang]" value="1" onclick="clearCacheParted('lang', this);" {{ aSettings.lang ? 'checked' : '' }}>
                                        </td>
                                        <td><label for="clearLangCache">{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEAR_LANG" }) }}</label></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="checkbox" id="clearMenuCache" name="clearcache[menu]" value="1" onclick="clearCacheParted('menu', this);" {{ aSettings.menu ? 'checked' : '' }}>
                                        </td>
                                        <td><label for="clearMenuCache">{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEAR_MENU" }) }}</label></td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>
                <p class="text-muted">
                    {{ translate({ ident: "SUABOCLEARCACHE_SAVE_NOTICE" }) }}
                </p>

                <img id="suaboclearcache-preloader" src="{{ oViewConf.getModuleUrl('suaboclearcache', 'img/preloader.gif') }}" alt="save" style="display:none;float:left;margin:7px 10px 0 10px;">

                {% if not oClearCache.isHtaccess %}
                    <button type="submit" class="btn btn-danger" onclick="document.clearcache.fnc.value = 'createHtaccessFile';">{{ translate({ ident: "SUABOCLEARCACHE_CREATE_HTACCESS" }) }}</button>
                {% endif %}

                <button type="submit" class="btn" onclick="document.clearcache.fnc.value = 'clearCache';">
                    {{ translate({ ident: "SUABOCLEARCACHE_CLEAR_CACHE_BUTTON" }) }}
                </button>
            </td>
            <td style="vertical-align: top;">
                <h2>{{ translate({ ident: "SUABOCLEARCACHE_INFORMATION" }) }}:</h2>
                <table class="info">
                    <tr><td colspan="2"><h3>{{ translate({ ident: "SUABOCLEARCACHE_SHOP_CACHE" }) }}:</h3></td></tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_SHOP_CACHE" }) }}:</td>
                        <td>{{ oClearCache.sCachePath }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_COUNT" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.iShopCacheFileCnt }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_SIZE" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.iShopCacheFileSize }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_IS_FOLDER_PROTECTED" }) }}:</td>
                        <td>
                            {% if oClearCache.isHtaccess %}
                                <span style="color:darkgreen;">{{ translate({ ident: "SUABOCLEARCACHE_YES" }) }}</span>
                            {% else %}
                                <span style="color:red;">{{ translate({ ident: "SUABOCLEARCACHE_NO" }) }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr><td colspan="2"><hr><h3>{{ translate({ ident: "SUABOCLEARCACHE_TEMPLATE_CACHE" }) }}:</h3></td></tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_TEMPLATE_CACHE" }) }}:</td>
                        <td>{{ oClearCache.templateCachePath }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_COUNT" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.templateCacheFileCnt }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_SIZE" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.templateCacheFileSize }}</td>
                    </tr>
                    <tr><td colspan="2"><hr><h3>{{ translate({ ident: "SUABOCLEARCACHE_TOTAL" }) }}:</h3></td></tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_COUNT" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.iFileCount }}</td>
                    </tr>
                    <tr>
                        <td>{{ translate({ ident: "SUABOCLEARCACHE_FILE_SIZE" }) }}:</td>
                        <td class="dynamic{% if blCacheCleared %} cleared{% endif %}">{{ oClearCache.iFileSize }}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {% if blCacheCleared %}
        <br />
        <div class="alert alert-success">
            <span style="font-size:22px;color:lightgreen;font-weight:bold;padding-right:10px;">&#10003;</span>
            <span style="font-size:14px;font-weight:bold;">{{ translate({ ident: "SUABOCLEARCACHE_CLEARCACHE_TEXT" }) }}</span>

            <div style="padding:0 32px;">
                {% if oClearCache.iMode == 0 %}
                    <p>
                        {{ translate({ ident: "SUABOCLEARCACHE_ALL_CLEAR" }) }}<br />
                        {{ oClearCache.iDeletedCacheFileCnt }} {{ translate({ ident: "SUABOCLEARCACHE_CACHE_FILES_DEL" }) }}
                    </p>
                {% else %}
                    <p>{{ translate({ ident: "SUABOCLEARCACHE_PART_CLEARED" }) }}:</p>
                    <ul style="width:150px;list-style: circle;margin:0 10px 0;">
                        {% for sSetting, sVal in oClearCache.aSettings %}
                            <li style="background: transparent;list-style: disc;">{{ sSetting }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
        <br/><br/>
    {% endif %}

    <h2>{{ translate({ ident: "SUABOCLEARCACHE_DEBUG" }) }}:</h2>
    <table>
        <colgroup>
            <col style="width: 50%;" />
            <col style="width: 50%;" />
        </colgroup>
        <tr>
            <td style="vertical-align: top;">
                <table class="info">
                    <tr>
                        <td style="text-align: left;">{{ translate({ ident: "SUABOCLEARCACHE_SHOP_ERROR_LOG" }) }}:</td>
                        <td>{{ oDebug.sShopLogPath }}</td>
                    </tr>
                    <tr>
                        <td style="text-align: left;">{{ translate({ ident: "SUABOCLEARCACHE_FILE_SIZE" }) }}:</td>
                        <td>{{ oDebug.sShopLogFileSize }}</td>
                    </tr>
                    {% if oDebug.sExceptionLogTail %}
                        <tr>
                            <td colspan="2">
                                <p>{{ translate({ ident: "SUABOCLEARCACHE_LAST_BYTES" }) }}:</p>
                                <pre>{{ oDebug.sExceptionLogTail|replace({'\\n': "\n"}) }}</pre>
                            </td>
                        </tr>
                    {% endif %}
                </table>
            </td>
            <td style="vertical-align: top;">
                <table class="info">
                    {% if oDebug.sPHPErrorLog and oDebug.sPHPErrorLogSize %}
                        <tr>
                            <td style="text-align: left;">{{ translate({ ident: "SUABOCLEARCACHE_PHP_ERROR_LOG" }) }}:</td>
                            <td>{{ oDebug.sPHPErrorLogPath }}</td>
                        </tr>
                        <tr>
                            <td style="text-align: left;">{{ translate({ ident: "SUABOCLEARCACHE_FILE_SIZE" }) }}:</td>
                            <td>
                                {% if oDebug.sPHPErrorLog %}
                                    {{ oDebug.sPHPErrorLogSize }}
                                {% elseif oDebug.sPHPErrorLogSize %}
                                    <span style="color: red;">{{ translate({ ident: oDebug.sPHPErrorLogSize }) }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td colspan="2">
                            {% if not oDebug.sPHPErrorLog %}
                                <p class="text-muted">
                                    {{ translate({ ident: "SUABOCLEARCACHE_NO_PHP_LOG" }) }}
                                </p>
                            {% elseif oDebug.sPHPErrorLogTail %}
                                <p>{{ translate({ ident: "SUABOCLEARCACHE_LAST_BYTES" }) }}:</p>
                                <pre>{{ oDebug.sPHPErrorLogTail }}</pre>
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</form>

<script type="text/javascript">
    parent.sShopTitle = "{{ actshopobj.oxshops__oxname.getRawValue()|addslashes|raw }}";
    parent.parent.sMenuItem = '{{ translate({ ident: "SUABOCLEARCACHE_TITLE" }) }}';
    parent.parent.sMenuSubItem = "";
    parent.parent.sWorkArea = "{{ _act }}";
    parent.setTitle();

    const fade = function(element) {
        let op = 1;
        const ccperiod = setInterval(function () {
            if (op <= 0.1) {
                op = 0.0;
                clearInterval(ccperiod);
                element.style.display = 'none';
            }
            element.style.opacity = op;
            element.style.filter = 'alpha(opacity=' + op * 100 + ")";
            op -= 0.1;
        }, 50);
    };
    const ajaxSave = function(mode, part, val) {
        const ple = document.getElementById('suaboclearcache-preloader');
        let xmlhttp = null;
        ple.style.display = 'block';
        if (window.XMLHttpRequest) {
            xmlhttp = new XMLHttpRequest();
        } else {
            xmlhttp = new ActiveXObject("Microsoft.XMLHTTP");
        }
        xmlhttp.onreadystatechange = function() {
            if (xmlhttp.readyState === 4 && xmlhttp.status === 200) {
                fade(ple);
            }
        };

        let url = document.getElementById('clearcache').getAttribute('action') + "cl=suaboclearcache&fnc=saveSetting&mode=" + mode;
        if(part !== undefined && part.length > 0) {
            url += "&name=" + part + "&value=" + val;
        }
        xmlhttp.open("GET", url, true);
        xmlhttp.send();
    };
    const clearCacheParted = function (part, elem) {
        document.getElementById('clearcacheall').checked = false;
        document.getElementById('clearcacheparted').checked = true;
        if (part != null && elem != null) {
            ajaxSave('1', part, elem.checked.toString());
        } else {
            ajaxSave('1');
        }
    };

    const clearCacheTotal = function () {
        ajaxSave('0');
    };
</script>

{% include "bottomnaviitem.html.twig" %}
